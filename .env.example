# Environment Configuration - NusaJalur (matchabaobei)
# Base Public URL: https://matchabaobei.stei.fun/api/v1

PROJECT_NAME="NusaJalur Backend"
PROJECT_SLUG="matchabaobei"
ENVIRONMENT="production"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000
BASE_URL="https://matchabaobei.stei.fun"
API_V1_PREFIX="/api/v1"

# Security & JWT
# Ganti dengan secret key acak yang kuat (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="supersecretjwtkey_matchabaobei_tst2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite with WAL mode)
# Gunakan relative / absolute path volume container
DATABASE_URL="sqlite:///./data/nusajalur.db"

# Server-to-Server B2B Authentication (X-API-Key)
# API key publik untuk kelompok partner (e.g. Belva / Health & Wellbeing)
# Disimpan dalam bentuk SHA-256 hash di database atau fallback env
DEFAULT_API_KEY="nj_live_matchabaobei_tst2026_secret_key"
DEFAULT_API_KEY_NAME="Belva Health & Wellbeing Group"

# Cloudflare Tunnel Token (didapatkan dari Cloudflare Zero Trust Dashboard)
# Diperlukan untuk container 'tunnel' pada docker-compose
TUNNEL_TOKEN="eyJhIjoiZXhhbXBsZXRva2VuMTIzNDU2Nzg5MCIsInQiOiIxMjM0NTY3OC0xMjM0LTEyMzQtMTIzNC0xMjM0NTY3ODEyMzQiLCJzIjoiZXhhbXBsZXNpZ25hdHVyZSJ9"
